      { "name": "nestedArrayField[].device.imei", "type": "String", "required": false, "description": "IMEI hoặc định danh thiết bị" },
      { "name": "data.id", "type": "String (UUID)", "required": true, "description": "UUID định danh giao dịch trong response" },
