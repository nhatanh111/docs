      { "name": "data.items[].name", "type": "String", "required": true, "description": "Tên item trong response" },
      { "name": "data.items[].quantity", "type": "Number", "required": true, "description": "Số lượng item" },
      { "name": "data.items[].price", "type": "Number", "required": true, "description": "Đơn giá item" },
      { "name": "data.certificateUrl", "type": "String (URL)", "required": true, "description": "Đường dẫn file PDF chứng nhận" }
    ]
  }
